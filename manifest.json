{
  "manifest_version": 3,
  "name": "SmartEGE",
  "version": "1.1.0",
  "permissions": ["storage", "activeTab"],
  "description": "AI educational assistant for EGE/OGE students — instant hints and theory on every task",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://reshu.ru/*",
        "*://*.reshu.ru/*",
        "*://sdamgia.ru/*",
        "*://*.sdamgia.ru/*",
        "*://oge.sdamgia.ru/*",
        "*://ege.sdamgia.ru/*",
        "*://fipi.ru/*",
        "*://*.fipi.ru/*"
      ],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["knowledge/*", "icons/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "SmartEGE",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
