{
  "manifest_version": 3,
  "name": "SmartEGE",
  "version": "2.0.0",
  "description": "AI educational assistant for EGE/OGE students — instant hints and theory on every task",
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "*://reshu.ru/*",
    "*://*.reshu.ru/*",
    "*://sdamgia.ru/*",
    "*://*.sdamgia.ru/*",
    "*://fipi.ru/*",
    "*://*.fipi.ru/*",
    "https://*.replit.dev/*",
    "https://*.repl.co/*",
    "http://localhost:3001/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-loader-CWUv0wqM.js"
      ],
      "matches": [
        "*://reshu.ru/*",
        "*://*.reshu.ru/*",
        "*://sdamgia.ru/*",
        "*://*.sdamgia.ru/*",
        "*://oge.sdamgia.ru/*",
        "*://ege.sdamgia.ru/*",
        "*://fipi.ru/*",
        "*://*.fipi.ru/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "knowledge/*",
        "icons/*",
        "assets/*"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "*://*.fipi.ru/*",
        "*://*.reshu.ru/*",
        "*://*.sdamgia.ru/*",
        "*://ege.sdamgia.ru/*",
        "*://fipi.ru/*",
        "*://oge.sdamgia.ru/*",
        "*://reshu.ru/*",
        "*://sdamgia.ru/*"
      ],
      "resources": [
        "assets/statsService-BG2plOgP.js",
        "assets/content.js-CQxLBPyf.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "SmartEGE",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
