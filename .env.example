# SmartEGE Backend — local development config
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (required by the backend)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Provider selection: openrouter, openai, deepseek, mistral, gemini, gigachat
AI_PROVIDER=gigachat

# Set only the key for the selected provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Preferred GigaChat credential: Authorization key from the GigaChat console.
# If set, it takes precedence over GIGACHAT_CLIENT_ID/GIGACHAT_CLIENT_SECRET.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional model override. Provider-specific model variables are also supported.
AI_MODEL=
OPENROUTER_MODEL=openai/gpt-4o-mini
GIGACHAT_MODEL=GigaChat

# Optional extension matcher threshold (higher = fewer, stricter matches).
VITE_KNOWLEDGE_MATCH_THRESHOLD=1.5

# JWT signing secret.
SESSION_SECRET=

# Server settings.
PORT=3001
NODE_ENV=development