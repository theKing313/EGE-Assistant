# SmartEGE Backend — local development config
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (required by the backend)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Provider selection: openrouter, openai, deepseek, mistral, gemini, gigachat
AI_PROVIDER=gigachat

# Set only the key for the selected provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# Preferred GigaChat credential: Authorization key from the GigaChat console.
# If set, it takes precedence over GIGACHAT_CLIENT_ID/GIGACHAT_CLIENT_SECRET.
