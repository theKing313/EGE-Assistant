GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Optional model override. Provider-specific model variables are also supported.
AI_MODEL=
OPENROUTER_MODEL=openai/gpt-4o-mini
GIGACHAT_MODEL=GigaChat

# Optional extension matcher threshold (higher = fewer, stricter matches).
VITE_KNOWLEDGE_MATCH_THRESHOLD=1.5

# JWT signing secret.
SESSION_SECRET=secret-change-me

# Server settings.
PORT=3001
NODE_ENV=development

# Premium billing (read by the API; do not hardcode in the extension)
PREMIUM_PRICE_RUB=149
PREMIUM_CURRENCY=RUB
STUDY_DAILY_GOAL=10
STUDY_TIMEZONE=Europe/Moscow